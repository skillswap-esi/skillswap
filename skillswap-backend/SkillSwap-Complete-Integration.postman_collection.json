{
  "info": {
    "name": "SkillSwap Complete Integration",
    "description": "Collection complète pour tester User Service, Skill Service et API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userServiceUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "skillServiceUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "skillId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "User Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/actuator/health",
              "host": ["{{userServiceUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Skill Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{skillServiceUrl}}/actuator/health",
              "host": ["{{skillServiceUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "API Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/actuator/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Service (Direct)",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"+33612345678\",\n  \"fullName\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/auth/register",
              "host": ["{{userServiceUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/users/{{userId}}",
              "host": ["{{userServiceUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Via API Gateway",
      "item": [
        {
          "name": "Register via Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.smith@example.com\",\n  \"phoneNumber\": \"+33687654321\",\n  \"fullName\": \"Jane Smith\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/register",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login via Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.smith@example.com\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get User via Gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/users/{{userId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Create Skill via Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('skillId', jsonData.skillId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cours de guitare\",\n  \"description\": \"Cours de guitare acoustique pour débutants et intermédiaires\",\n  \"category\": \"MUSIQUE\",\n  \"latitude\": 48.8566,\n  \"longitude\": 2.3522\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/skills",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "skills"]
            }
          }
        },
        {
          "name": "Search Skills Near via Gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/skills/near?lat=48.8566&lng=2.3522&radius=10",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "skills", "near"],
              "query": [
                {
                  "key": "lat",
                  "value": "48.8566"
                },
                {
                  "key": "lng",
                  "value": "2.3522"
                },
                {
                  "key": "radius",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Skills via Gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/skills/user/{{userId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "skills", "user", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update Skill via Gateway",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cours de guitare avancé\",\n  \"description\": \"Cours de guitare pour niveau avancé\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/skills/{{skillId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "skills", "{{skillId}}"]
            }
          }
        },
        {
          "name": "Delete Skill via Gateway",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/skills/{{skillId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "skills", "{{skillId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Test Data Creation",
      "item": [
        {
          "name": "Create Multiple Skills",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Réparation vélo\",\n  \"description\": \"Réparation et entretien de vélos\",\n  \"category\": \"BRICOLAGE\",\n  \"latitude\": 48.8606,\n  \"longitude\": 2.3376\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/skills",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "skills"]
            }
          }
        }
      ]
    }
  ]
}
