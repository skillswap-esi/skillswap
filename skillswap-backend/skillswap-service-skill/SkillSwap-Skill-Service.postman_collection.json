{
  "info": {
    "name": "SkillSwap Skill Service",
    "description": "Collection pour tester le service de gestion des compétences avec géolocalisation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "skillId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Créer une compétence",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('skillId', jsonData.skillId);",
              "    pm.test('Compétence créée avec succès', function () {",
              "        pm.expect(jsonData.skillId).to.not.be.null;",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Cours de guitare\",\n  \"description\": \"Cours de guitare acoustique pour débutants et intermédiaires\",\n  \"category\": \"MUSIQUE\",\n  \"latitude\": 48.8566,\n  \"longitude\": 2.3522\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills"]
        }
      }
    },
    {
      "name": "2. Rechercher à proximité",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/skills/near?lat=48.8566&lng=2.3522&radius=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills", "near"],
          "query": [
            {
              "key": "lat",
              "value": "48.8566"
            },
            {
              "key": "lng",
              "value": "2.3522"
            },
            {
              "key": "radius",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "3. Rechercher avec catégorie",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/skills/near?lat=48.8566&lng=2.3522&radius=10&category=MUSIQUE",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills", "near"],
          "query": [
            {
              "key": "lat",
              "value": "48.8566"
            },
            {
              "key": "lng",
              "value": "2.3522"
            },
            {
              "key": "radius",
              "value": "10"
            },
            {
              "key": "category",
              "value": "MUSIQUE"
            }
          ]
        }
      }
    },
    {
      "name": "4. Obtenir compétences par utilisateur",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/skills/user/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills", "user", "{{userId}}"]
        }
      }
    },
    {
      "name": "5. Obtenir compétence par ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/skills/{{skillId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills", "{{skillId}}"]
        }
      }
    },
    {
      "name": "6. Mettre à jour compétence",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Cours de guitare avancé\",\n  \"description\": \"Cours de guitare pour niveau avancé\",\n  \"active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills/{{skillId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills", "{{skillId}}"]
        }
      }
    },
    {
      "name": "7. Supprimer compétence",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/skills/{{skillId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills", "{{skillId}}"]
        }
      }
    },
    {
      "name": "Exemples - Créer compétence BRICOLAGE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Réparation vélo\",\n  \"description\": \"Réparation et entretien de vélos\",\n  \"category\": \"BRICOLAGE\",\n  \"latitude\": 48.8606,\n  \"longitude\": 2.3376\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills"]
        }
      }
    },
    {
      "name": "Exemples - Créer compétence SPORT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Cours de yoga\",\n  \"description\": \"Cours de yoga pour tous niveaux\",\n  \"category\": \"SPORT\",\n  \"latitude\": 48.8529,\n  \"longitude\": 2.3499\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills"]
        }
      }
    },
    {
      "name": "Exemples - Créer compétence INFORMATIQUE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Développement web\",\n  \"description\": \"Formation en développement web (HTML, CSS, JavaScript)\",\n  \"category\": \"INFORMATIQUE\",\n  \"latitude\": 45.7640,\n  \"longitude\": 4.8357\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/skills",
          "host": ["{{baseUrl}}"],
          "path": ["api", "skills"]
        }
      }
    }
  ]
}
