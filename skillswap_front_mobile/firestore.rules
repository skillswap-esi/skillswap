rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is participant in a chat thread
    function isParticipant(threadId) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(threadId)).data.firebaseUids;
    }
    
    // Chat threads collection
    match /chat_threads/{threadId} {
      // Allow authenticated users to read threads they're part of
      allow read: if isAuthenticated() && 
                     request.auth.uid in resource.data.firebaseUids;
      
      // Allow authenticated users to create new threads
      allow create: if isAuthenticated() && 
                       request.auth.uid in request.resource.data.firebaseUids;
      
      // Allow participants to update thread (for lastMessage, adding firebaseUids, etc.)
      allow update: if isAuthenticated() && 
                       (request.auth.uid in resource.data.firebaseUids ||
                        request.auth.uid in request.resource.data.firebaseUids);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow participants to read messages
        allow read: if isParticipant(threadId);
        
        // Allow participants to create messages
        allow create: if isParticipant(threadId) && 
                         request.auth.uid == request.resource.data.senderId;
        
        // Allow participants to update messages (for read status)
        allow update: if isParticipant(threadId);
      }
    }
    
    // Notifications collection (stored by mobile app)
    match /notifications/{userId} {
      match /items/{notificationId} {
        // Users can only read/write their own notifications
        allow read, write: if isAuthenticated() && 
                              request.auth.uid == userId;
      }
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
