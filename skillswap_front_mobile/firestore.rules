rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is participant (for existing threads)
    function isParticipantInExistingThread(threadId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/chat_threads/$(threadId)) &&
             request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(threadId)).data.firebaseUids;
    }
    
    // Chat threads collection
    match /chat_threads/{threadId} {
      // Allow authenticated users to read threads where they are a participant (by firebaseUids)
      // Also allow reading non-existent docs (for checking if thread exists)
      allow read: if isAuthenticated() && 
                     (resource == null || 
                      (resource.data.firebaseUids != null && request.auth.uid in resource.data.firebaseUids));
      
      // Allow list/query operations for authenticated users on their own threads
      allow list: if isAuthenticated();
      
      // Allow authenticated users to create new threads
      allow create: if isAuthenticated() && 
                       request.resource.data.firebaseUids != null &&
                       request.auth.uid in request.resource.data.firebaseUids;
      
      // Allow participants to update thread (for lastMessage, adding firebaseUids, etc.)
      allow update: if isAuthenticated() && 
                       ((resource.data.firebaseUids != null && request.auth.uid in resource.data.firebaseUids) ||
                        (request.resource.data.firebaseUids != null && request.auth.uid in request.resource.data.firebaseUids));
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow participants to read messages (check parent thread)
        allow read: if isAuthenticated() && 
                       isParticipantInExistingThread(threadId);
        
        // Allow participants to create messages
        allow create: if isAuthenticated() && 
                         isParticipantInExistingThread(threadId) &&
                         request.auth.uid == request.resource.data.senderId;
        
        // Allow participants to update messages (for read status)
        allow update: if isAuthenticated() && 
                         isParticipantInExistingThread(threadId);
      }
    }
    
    // FCM tokens collection (for notifications)
    match /fcm_tokens/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Notifications collection (stored by mobile app)
    match /notifications/{userId} {
      match /items/{notificationId} {
        // Users can only read/write their own notifications
        allow read, write: if isAuthenticated() && 
                              request.auth.uid == userId;
      }
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
